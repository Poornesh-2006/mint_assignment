# Groq free tier — optional. The crawler, on-page audit, NAP regex/schema
# extractors, and lexical Q&A all run without a key. When set, LangChain
# agents refine NAP extraction and pick the grounded Q&A excerpt.
GROQ_API_KEY=

# Default matches the Helpora course notebook. Override if Groq deprecates it.
GROQ_MODEL=openai/gpt-oss-120b
